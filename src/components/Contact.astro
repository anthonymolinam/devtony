---
import DiscordLogo from "@phosphor-icons/core/regular/discord-logo.svg";
import GithubLogo from "@phosphor-icons/core/regular/github-logo.svg";
import LinkedinLogo from "@phosphor-icons/core/regular/linkedin-logo.svg";
import CopyButton from "@/components/CopyButton.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { site } from "@/data/site";

const profiles = [
  { href: site.github, label: "GitHub", Icon: GithubLogo },
  { href: site.linkedin, label: "LinkedIn", Icon: LinkedinLogo },
  { href: site.discord, label: "Discord", Icon: DiscordLogo },
];
---

<section id="contact" tabindex="-1" aria-labelledby="contact-title">
  <SectionTitle id="contact-title">Have a project or a role in mind?</SectionTitle>
  <p class="mt-stack flex flex-wrap items-center gap-x-5 gap-y-3">
    <a href={`mailto:${site.email}`} class="link text-lead break-all">{site.email}</a>
    <CopyButton value={site.email} class="btn-secondary" message="Email copied to clipboard.">
      <span data-copy-label>Copy email</span>
    </CopyButton>
  </p>
  <ul class="mt-6 flex flex-wrap gap-5">
    {
      profiles.map(({ href, label, Icon }) => (
        <li>
          <a href={href} class="link inline-flex min-h-tap items-center gap-2" rel="noopener me">
            <Icon width={20} height={20} aria-hidden="true" />
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
