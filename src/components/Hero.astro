---
import { site } from "@/data/site";
---

<section aria-labelledby="hero-title" class="pt-8 sm:pt-9">
  <h1 id="hero-title" class="font-display text-display">{site.name}</h1>
  <p class="mt-4 max-w-measure text-lead text-ink-muted">{site.role}</p>
  <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
    <a href={`mailto:${site.email}`} class="btn-primary">Get in touch</a>
    <p class="chip chip-status">
      <span class="status-dot" aria-hidden="true"></span>
      Open to work
    </p>
  </div>
</section>
