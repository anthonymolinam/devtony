---
import Cpu from "@phosphor-icons/core/regular/cpu.svg";
import GraphicsCard from "@phosphor-icons/core/regular/graphics-card.svg";
import Keyboard from "@phosphor-icons/core/regular/keyboard.svg";
import Mouse from "@phosphor-icons/core/regular/mouse-simple.svg";
import LocalTime from "@/components/LocalTime.astro";
import PlaylistCard from "@/components/PlaylistCard.astro";
import { setup, site } from "@/data/site";

const setupIcons = { cpu: Cpu, gpu: GraphicsCard, keyboard: Keyboard, mouse: Mouse };
---

<!--
  Source order is the phone order; wider screens place the cards explicitly.
-->
<section aria-label="Right now" class="grid gap-bento sm:grid-cols-2 md:grid-cols-3">
  <LocalTime class="sm:col-start-1 sm:row-start-2 md:col-start-3 md:row-start-1" />

  <PlaylistCard class="sm:col-span-2 sm:row-start-1 md:col-start-1" />

  <article class="card flex flex-col gap-4 sm:col-span-2 sm:row-start-3 md:col-start-2 md:row-start-2">
    <h2 class="card-title">Availability</h2>
    <p class="chip chip-status self-start">
      <span class="status-dot" aria-hidden="true"></span>
      Open to work
    </p>
    <!-- TODO(content): the role you are looking for. -->
    <p class="text-lead">Frontend roles, remote or in Bogotá.</p>
    <a href={`mailto:${site.email}`} class="link self-start text-small">{site.email}</a>
  </article>

  <article class="card flex flex-col gap-4 sm:col-start-2 sm:row-start-2 md:col-start-1 md:row-start-2">
    <h2 class="card-title">Setup</h2>
    <ul class="flex flex-col gap-3">
      {
        setup.map((item) => {
          const Icon = setupIcons[item.icon];
          return (
            <li class="flex items-center gap-3">
              <Icon width={20} height={20} class="shrink-0 text-ink-muted" aria-hidden="true" />
              <span>
                <span class="sr-only">{item.label}: </span>
                {item.value}
              </span>
            </li>
          );
        })
      }
    </ul>
  </article>
</section>
